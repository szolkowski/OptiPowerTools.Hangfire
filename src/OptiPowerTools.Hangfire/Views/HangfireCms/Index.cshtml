@{
    Layout = string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewBag.DashboardTitle</title>
    <episerver-resources area="ShellCore" />
    <episerver-resources area="ShellCoreLightTheme" />
    <style>
        html, body, .iframe-container {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>
    <platform-navigation />
    <platform-navigation-wrapper additional-class="iframe-container">
        <iframe src="@ViewBag.DashboardPath" title="@ViewBag.DashboardTitle">
            <p>Your browser does not support iframes.</p>
        </iframe>
    </platform-navigation-wrapper>
</body>
</html>
