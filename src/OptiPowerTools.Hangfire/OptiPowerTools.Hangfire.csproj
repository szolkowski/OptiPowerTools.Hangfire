<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>

    <!-- NuGet Package Metadata -->
    <PackageId>OptiPowerTools.Hangfire</PackageId>
    <Version>0.1.1</Version>
    <Authors>Stanisław Szołkowski</Authors>
    <Description>One-liner bootstrap for Hangfire integration with Optimizely CMS 12. Includes SQL Server storage, dashboard with Optimizely role-based auth, and easy configuration.</Description>
    <PackageTags>Optimizely;Hangfire;OptimizelyModulePackage;BackgroundJobs;CMS;EPiServer</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/szolkowski/OptiPowerTools.Hangfire</PackageProjectUrl>
    <Copyright>Stanisław Szołkowski</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RepositoryUrl>https://github.com/szolkowski/OptiPowerTools.Hangfire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeToolsAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptiPowerTools.Hangfire.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.23" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Console" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.AspNetCore" Version="[12.0.3,13.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[12.0.3,13.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiPowerTools.Hangfire.Tools\OptiPowerTools.Hangfire.Tools.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="IncludeToolsAssembly">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)OptiPowerTools.Hangfire.Tools.dll" />
    </ItemGroup>
  </Target>

</Project>
