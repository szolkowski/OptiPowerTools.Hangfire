<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- NuGet Package Metadata -->
    <Version>2.0.0-beta</Version>
    <Authors>Stanisław Szołkowski</Authors>
    <Copyright>Stanisław Szołkowski 2026</Copyright>
    <Title>OptiPowerTools: Hangfire</Title>
    <Description>One-liner bootstrap for Hangfire integration with Optimizely CMS 13. Includes SQL Server storage, dashboard with Optimizely role-based auth, CMS menu integration, Hangfire.Console support, built-in job filters for concurrency control and lifecycle management, and easy configuration via options pattern or appsettings.json.</Description>
    
    <PackageId>OptiPowerTools.Hangfire</PackageId>
    <PackageTags>Optimizely;Hangfire;CMS;BackgroundJobs;BackgroundProcessing;JobFilters;EPiServer</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/szolkowski/OptiPowerTools.Hangfire</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RepositoryUrl>https://github.com/szolkowski/OptiPowerTools.Hangfire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink & deterministic builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Package validation (disabled for 2.0.0 major version bump; re-enable with 2.0.0 as baseline) -->
    <EnablePackageValidation>false</EnablePackageValidation>

    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeToolsAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OptiPowerTools.Hangfire.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.23" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Console" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.AspNetCore" Version="[13.0.0,14.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="[13.0.0,14.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OptiPowerTools.Hangfire.Tools\OptiPowerTools.Hangfire.Tools.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\images\OptiToolsHangfireDashboard.png" Pack="true" PackagePath="images\OptiToolsHangfireDashboard.png" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt"/>
  </ItemGroup>

  <Target Name="IncludeToolsAssembly">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)OptiPowerTools.Hangfire.Tools.dll" />
    </ItemGroup>
  </Target>

</Project>
